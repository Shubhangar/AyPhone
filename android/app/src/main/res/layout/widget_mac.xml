<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, two rows and up: the Mac, six actions and its media. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_widget_laptop" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3EE90FF"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_files"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:id="@+id/widget_files_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_file"
                android:tint="#FFE7D9FF" />
            <TextView
                android:id="@+id/widget_files_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Send"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:id="@+id/widget_share_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_screen_share"
                android:tint="#FFE7D9FF" />
            <TextView
                android:id="@+id/widget_share_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Share"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_lock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:id="@+id/widget_lock_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_lock"
                android:tint="#FFE7D9FF" />
            <TextView
                android:id="@+id/widget_lock_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Lock"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_mute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:id="@+id/widget_mute_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_volume_up"
                android:tint="#FFE7D9FF" />
            <TextView
                android:id="@+id/widget_mute_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Mute"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_trackpad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:id="@+id/widget_trackpad_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_trackpad"
                android:tint="#FFE7D9FF" />
            <TextView
                android:id="@+id/widget_trackpad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Trackpad"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_find"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:id="@+id/widget_find_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_find"
                android:tint="#FFE7D9FF" />
            <TextView
                android:id="@+id/widget_find_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="Find"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:minHeight="72dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/widget_media_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Mac media"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Previous" android:padding="10dp" android:src="@drawable/ic_w_previous" />
            <ImageView android:id="@+id/widget_play" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/widget_button_on_bg" android:contentDescription="Play or pause" android:padding="12dp" android:src="@drawable/ic_w_play" />
            <ImageView android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Next" android:padding="10dp" android:src="@drawable/ic_w_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
